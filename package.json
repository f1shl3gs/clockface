{
  "name": "@influxdata/clockface",
  "version": "6.3.11",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/index.css"
  ],
  "style": "dist/index.css",
  "description": "UI Kit for building Chronograf and other Time Series visualization applications",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/influxdata/clockface"
  },
  "engines": {
    "yarn": ">=1.16.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/storybook-deployer": "^2.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/classnames": "^2.2.7",
    "@types/jsdom": "^30",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "classnames": "^2.2.6",
    "colord": "^2.10.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rolldown": "^1.2.5",
    "rollup-plugin-sass": "^1.15.3",
    "sass": "^1.103.1",
    "storybook": "^10.5.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "start": "rolldown --watch",
    "build": "rm -rf dist && NODE_ENV=production rolldown -c rolldown.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:dev": "rm -rf dist && NODE_ENV=development rolldown -c rolldown.config.ts && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "ci": "yarn test && yarn lint && yarn typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "fmt": "biome format --check src",
    "fmt:fix": "biome format --write src",
    "typecheck": "tsc --noEmit --pretty",
    "fix": "biome check --write src",
    "storybook": "storybook dev -p 9001 -c .storybook",
    "publishStorybook": "storybook-to-ghpages --out=.out",
    "prepack": "yarn build"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
