  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./dist/variables.scss": "./dist/variables.scss",
    "./dist/Styles/shared.css": "./dist/Styles/shared.css",
    "./src/Types": "./src/Types/index.js"
  }
